---
import { useTranslation } from '../features/i18n';
import type { Lang } from '../features/i18n';
import ThemeToggle from '../features/theme/ThemeToggle.astro';
import SearchModal from '../features/search/SearchModal.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const { t } = useTranslation(lang);

const navLinks = [
  { href: '/', label: t('nav.home') },
  { href: '/articles', label: t('nav.articles') },
  { href: '/photos', label: t('nav.photos') },
  { href: '/about', label: t('nav.about') },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <nav class="site-nav">
    <a href="/" class="site-name">Ningen</a>

    <div class="nav-right">
      <ul class="nav-links">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { 'nav-link--active': currentPath === link.href }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <button id="search-trigger" class="search-trigger" aria-label="Search">
        ⌘K
      </button>
      <ThemeToggle />
    </div>
  </nav>
</header>

<SearchModal />

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav {
    max-width: var(--width-wide);
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .site-name {
    font-family: var(--font-serif);
    font-weight: var(--font-weight-medium);
    font-size: var(--text-base);
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .nav-links {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 150ms;
  }

  .nav-link--active {
    color: var(--color-text);
  }

  .nav-link:hover:not(.nav-link--active) {
    color: var(--color-text);
  }

  .search-trigger {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: none;
    border: 1px solid var(--color-border);
    padding: 2px var(--space-sm);
    cursor: pointer;
    border-radius: 4px;
    transition: color 150ms, border-color 150ms;
  }

  .search-trigger:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }
</style>

<script>
  import { openSearch } from '../features/search';

  document.getElementById('search-trigger')?.addEventListener('click', openSearch);
</script>
