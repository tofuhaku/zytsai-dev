---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  date: Date;
  description: string;
  lang?: string;
}

const { title, date, description, lang = 'en' } = Astro.props;

const formattedDate = date.toLocaleDateString('en-CA');
---

<BaseLayout title={title} description={description} lang={lang}>
  <Header slot="header" />

  <article style="
    max-width: var(--width-content);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
  ">
    <header style="margin-bottom: var(--space-lg);">
      <h1 style="
        font-size: 1.75rem;
        font-weight: 600;
        line-height: 1.3;
        margin: 0 0 var(--space-sm);
      ">{title}</h1>
      <time
        datetime={date.toISOString()}
        style="color: var(--color-text-muted); font-size: 0.9rem;"
      >{formattedDate}</time>
      <p style="
        color: var(--color-text-muted);
        margin: var(--space-sm) 0 0;
      ">{description}</p>
    </header>

    <div style="border-top: 1px solid var(--color-border); padding-top: var(--space-lg);">
      <slot />
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>
