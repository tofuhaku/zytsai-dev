---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="About">
  <Header slot="header" />

  <div class="page">
    <h1 class="name">Yuki</h1>
    <p class="bio">
      Software developer and occasional photographer based somewhere with good coffee.
      I write about things I build, break, and figure out along the way.
      Sometimes in English, sometimes in Japanese, sometimes in Chinese.
    </p>

    <hr class="divider" />

    <section class="section">
      <h2 class="section-title">Interests</h2>
      <ul class="list">
        <li>Software development &amp; system design</li>
        <li>Street and documentary photography</li>
        <li>Language learning</li>
        <li>Coffee</li>
      </ul>
    </section>

    <hr class="divider" />

    <section class="section">
      <h2 class="section-title">Contact</h2>
      <ul class="contact-list">
        <li>
          <span class="contact-label">Email</span>
          <a href="mailto:hello@zytsai.dev" class="contact-link">hello@zytsai.dev</a>
        </li>
        <li>
          <span class="contact-label">GitHub</span>
          <a href="https://github.com/tofuhaku" class="contact-link" target="_blank" rel="noopener">
            github.com/tofuhaku
          </a>
        </li>
      </ul>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .page {
    max-width: var(--width-content);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
  }

  .name {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-md);
  }

  .bio {
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--leading-loose);
  }

  .divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-lg) 0;
  }

  .section-title {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md);
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .list li {
    font-size: var(--text-base);
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .contact-list li {
    display: flex;
    gap: var(--space-lg);
    align-items: baseline;
  }

  .contact-label {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    width: 60px;
    flex-shrink: 0;
  }

  .contact-link {
    font-size: var(--text-base);
    color: var(--color-text);
    text-decoration: none;
    transition: color 150ms;
  }

  .contact-link:hover {
    color: var(--color-accent);
  }
</style>
